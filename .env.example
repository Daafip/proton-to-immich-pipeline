# Copy to .env next to docker-compose.yml. Never commit it.
#
# WHY THE FIRST ACCOUNT IS CALLED "default"
#
# An existing single-account install already has every row in its database
# stamped `default`, and `default` is special-cased throughout: it keeps
# sync.lock, status.json and the original MQTT node and topic, so Home
# Assistant entities do not move. Keeping the name is the zero-migration path.
#
# A fresh install can call it anything. Renaming an existing one is a real
# migration -- see docs/operations.md, "Going from one account to two".

# The uid/gid that owns the bind-mounted state and staging directories.
#   id -u ; id -g
PIS_UID=1000
PIS_GID=1000

# Decides when agent.at fires.
TZ=Europe/Amsterdam

# Where the databases and each pipeline's staging tree live on the host.
# Point these at the SSD, not the VM disk.
PIS_STATE_DIR=/mnt/immich/pis/state
DEFAULT_STAGING=/mnt/immich/pis/staging/default
MIRJAM_STAGING=/mnt/immich/pis/staging/mirjam

# The UI. `docker compose run --rm ui web-password` prints the hash.
# serve refuses a non-loopback bind without one.
PIS_WEB_PASSWORD_HASH=
PIS_WEB_PORT=8080

# One Immich instance, one USER per person, one API key each.
#
# The keys are what keep the libraries apart: each is issued by that person's
# own Immich user (their Account Settings -> API Keys), and an upload lands in
# whichever user's library the key belongs to. Two accounts sharing a key
# would pile both libraries into one user, so the config check refuses it.
#
# Separate Immich *instances* work too -- just give each its own URL below.
IMMICH_URL=http://immich-server:2283/api
DEFAULT_IMMICH_API_KEY=
MIRJAM_IMMICH_API_KEY=

# Per-pipeline override, only if the two people are on different instances.
#DEFAULT_IMMICH_URL=http://immich-a:2283/api
#MIRJAM_IMMICH_URL=http://immich-b:2283/api

# The docker network the Immich stack runs on. `docker network ls`.
# Not needed if you point IMMICH_URL at a host address instead.
IMMICH_NETWORK=immich_default
