# Copy to .env next to docker-compose.yml. Never commit it.
#
# NOTHING HERE IS NAMED AFTER A PERSON. Everything per-account is derived from
# the account name -- see config.docker.yaml, where the paths are written once
# with `{account}`. Adding a fifth person touches this file not at all.
#
# Each person's Immich API key goes in its own file instead:
#
#   mkdir -p secrets && chmod 700 secrets
#   printf '%s' 'THE-KEY-FOR-THAT-USER' > secrets/alice.key
#   chmod 600 secrets/*.key

# The uid/gid that owns the bind-mounted state, staging and secrets dirs.
#   id -u ; id -g
PIS_UID=1000
PIS_GID=1000

# Decides when agent.at fires.
TZ=Europe/Amsterdam

# Host paths. Point them at the SSD, not the VM disk.
#
# CREATE THESE YOURSELF before the first `docker compose up`, owned by the
# uid above -- a bind mount whose source does not exist is created by the
# docker daemon as root, and these containers do not run as root:
#
#   sudo install -d -o 1000 -g 1000 /mnt/immich/pis/{state,staging,secrets}
#   sudo chmod 700 /mnt/immich/pis/secrets
#
# Use the NUMERIC uid above, not `$(id -u)`: that is 0 when you are already
# root, which chowns them to root -- the very thing you are fixing. And scope
# it to these directories, never to a parent like /mnt/immich, which also
# holds Immich's own data.
#
#   state    one <account>.sqlite per pipeline, plus the UI's cookie secret
#   staging  one subdirectory per pipeline, created on first run
#   secrets  one <account>.key per pipeline, mounted read-only
PIS_STATE_DIR=/mnt/immich/pis/state
PIS_STAGING_DIR=/mnt/immich/pis/staging
PIS_SECRETS_DIR=/mnt/immich/pis/secrets

# One Immich instance, one USER per person, one API key each (in the files
# above). The key is what decides whose library an upload lands in; two
# accounts sharing one is refused by the config check.
#
# Someone on a different instance overrides IMMICH_INSTANCE_URL in their own
# service block in docker-compose.yml.
IMMICH_URL=http://immich-server:2283/api

# The docker network the Immich stack runs on. `docker network ls`.
# Not needed if you point IMMICH_URL at a host address instead.
IMMICH_NETWORK=immich_default

# MQTT / Home Assistant. Also set `mqtt.enabled: true` in config.yaml.
# The host is the broker as seen FROM THE CONTAINER: not 127.0.0.1 (that is
# the container itself) -- use the Home Assistant / Mosquitto host's IP.
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# The UI. Generate the hash with:
#   docker compose run --rm ui web-password
# and paste the PIS_WEB_PASSWORD_HASH=... line it prints. `serve` refuses a
# non-loopback bind without one.
#
# The hash is colon-separated (scrypt:32768:8:1:salt:key). It must NOT contain
# `$`: compose interpolates values from this file, so `$32768` would be read
# as an undefined variable and the hash would arrive truncated -- every login
# then fails with nothing in the log to say why. `serve` refuses to start on a
# hash that looks like that, rather than letting you lock yourself out.
PIS_WEB_PASSWORD_HASH=
PIS_WEB_PORT=8080

# Who may embed the UI in an iframe (a Home Assistant panel/webpage card).
# Comma-separated CSP sources; empty means nobody, which is the default.
# CSP has no CIDR syntax, so list Home Assistant's real address(es):
#   PIS_WEB_FRAME_ANCESTORS='self',http://homeassistant.local:8123,http://192.168.68.50:8123
# Not needed for a hass_ingress panel: that is served from Home Assistant's own
# origin, and the UI allows it automatically (see PIS_WEB_TOKEN_HASH).
PIS_WEB_FRAME_ANCESTORS=

# A Home Assistant panel through hass_ingress (github.com/lovelylain/hass_ingress)
# can log you in without the password: HA adds `Authorization: Bearer <token>`
# to every request it forwards. Generate the token and this hash with:
#   docker compose run --rm ui web-token
# The token goes in HA's secrets.yaml, the hash here. Empty = no token login;
# the password keeps working either way.
PIS_WEB_TOKEN_HASH=
