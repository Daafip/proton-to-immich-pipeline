# Real config holds an Immich API key and the Proton paths.
config.yaml
*.local.yaml

# CLI dumps: these carry node UIDs and the account email.
*dump*.json
hidden_dump.json

# Runtime artefacts, if anyone ever runs the pipeline from the checkout.
staging/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite.pre-v3-*
status.json
status-*.json

# v2: the web UI's cookie-signing key, and the per-account Immich keys.
# Holding the secret is enough to mint a session.
web-secret
*.key

# Docker: .env holds every API key and the web password hash, and the bind
# mounts land here if you leave the defaults in docker-compose.yml.
.env
/state/
*.sqlite.pre-split-*
*.sqlite.split-*

__pycache__/
*.pyc
.venv/

hidden_*