[Unit]
Description=Proton Drive -> Immich sync
Documentation=file:/opt/proton-to-immich-pipeline/README.md
After=network-online.target mnt-immich.mount docker.service
Wants=network-online.target
# The SSD is mounted nofail, so refuse to run if staging is not there:
# downloading into an unmounted mountpoint would fill the VM disk.
RequiresMountsFor=/mnt/immich

[Service]
Type=oneshot
# Own service account, created at install time: the Immich docker stack does
# not create a host user. It only needs to own /mnt/immich/staging.
User=protonsync
Group=protonsync
# immich.upload_mode: cli talks to the docker socket, which is root-equivalent.
# Not needed for upload_mode: api.
#SupplementaryGroups=docker
WorkingDirectory=/opt/proton-to-immich-pipeline
# Secrets stay out of the config file on the SSD.
# IMMICH_API_KEY=... (chmod 640, root:protonsync)
EnvironmentFile=/etc/proton-to-immich-pipeline/env
Environment=PIS_CONFIG=/etc/proton-to-immich-pipeline/config.yaml
Environment=PROTON_DRIVE_CACHE_DIR=/mnt/immich/staging/.proton
ExecStart=/usr/bin/python3 /opt/proton-to-immich-pipeline/sync.py run

# A whole night is plenty; the flock guard stops the next timer tick from
# overlapping if a backfill runs long.
TimeoutStartSec=8h
Nice=10
IOSchedulingClass=idle

# exit 1 = partial failure (some assets failed), still a completed run.
# exit 2 = auth failure, exit 3 = another run holds the lock.
SuccessExitStatus=0 1 3

# Hardening. Loosen only if the Proton CLI's keyring access needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/mnt/immich/staging
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
