[Unit]
Description=Nightly Proton Drive -> Immich sync
Documentation=file:/opt/proton-immich-sync/README.md

[Timer]
# Nightly, after the phone has had all day to back up to Proton.
OnCalendar=*-*-* 03:15:00
# Spread load and avoid a thundering herd against Proton's API.
RandomizedDelaySec=30m
# If the VM was off at 03:15, run once it comes back.
Persistent=true
Unit=proton-immich-sync.service

[Install]
WantedBy=timers.target
